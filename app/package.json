{
  "name": "sql-xray",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "description": "把屎山 SQL 讲成人话的纯前端工具",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "build:single": "tsc --noEmit && vite build --config vite.config.single.ts && node scripts/inline-single.mjs && node scripts/check-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:privacy": "node scripts/check-privacy.mjs",
    "bench": "vitest run --config vitest.bench.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "node-sql-parser": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
